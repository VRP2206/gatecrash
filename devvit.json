{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "gatecrash-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      },
      "daily-post-retry": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "20 * * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Gatecrash: post today's board",
        "description": "Creates today's puzzle post if it does not exist yet",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-today"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
